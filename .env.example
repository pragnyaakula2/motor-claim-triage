# Copy to .env.  Nothing secret or provider-specific is committed; every value below is a placeholder or a dev default.
# The defaults run the WHOLE stack offline (scripted LLM stub + hashing embedder) so `docker compose up` always serves requests.

# ---- LLM provider (OpenAI-compatible HTTP API; swap vendors by changing these three values only) ----
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://llm-stub:8200/v1      # production: your provider's base URL
LLM_API_KEY=dev                            # production: your key (never commit it)
LLM_MODEL=stub-scripted                    # production: your model name
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=0.5
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_S=20
LLM_PRICE_IN_PER_1K_USD=0                  # notional prices for cost accounting; fill from your provider's price list
LLM_PRICE_OUT_PER_1K_USD=0
STUB_LATENCY_MS=800                        # llm-stub only
STUB_JITTER_MS=200

# ---- Embeddings / index (read by the retrieval image at BUILD time: docker compose build) ----
EMBEDDING_BACKEND=hashing                  # dev/CI/offline. Production: sentence_transformers (needs EMBEDDING_MODEL)
EMBEDDING_MODEL=                           # e.g. a small sentence-transformers model name; baked into the image at build
CHUNK_TARGET_CHARS=900

# ---- Agent bounds (A1) ----
AGENT_MAX_STEPS=8                          # LLM decisions per verification attempt
AGENT_MAX_TOOL_CALLS=12
AGENT_DEADLINE_S=45
AGENT_MAX_VERIFY_ATTEMPTS=3
RUN_DEADLINE_S=90
VERIFIER_LLM_CHECK=false                   # optional LLM entailment judge on top of deterministic checks V1-V7
TOOL_TIMEOUT_S=8
TOOL_MAX_RETRIES=2

# ---- Prompt versions (L2) ----
PROMPT_VERSION_TRIAGE=v1
PROMPT_VERSION_COVERAGE=v1                 # v0 = naive baseline, v1 = tuned, v2 = variant

# ---- Routing thresholds (F6) ----
FAST_TRACK_MAX_INR=20000                   # mirrors the claims page note
LATE_REPORT_DAYS=7
WEAK_RETRIEVAL_THRESHOLD=0.2               # below this top score the answer is escalated, not generated

# ---- Queue / workers ----
WORKER_CONCURRENCY=16                      # threads per worker process (see docs/SLO.md for why 16)
STREAM_CLAIM_IDLE_MS=60000                 # pending messages idle longer than this are re-claimed by a live worker
RUN_TTL_S=86400

# ---- Caching / rate limiting (D7) ----
CACHE_ENABLED=true
RUN_CACHE_ENABLED=true
CACHE_TTL_S=3600
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_BURST=10

# ---- Guardrails (L4) ----
INJECTION_BLOCK_SCORE=0.8
INJECTION_FLAG_SCORE=0.4

# ---- Quality sampling (L6) ----
QUALITY_SAMPLE_RATE=0.25

# ---- Observability ----
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318   # empty disables tracing export
GRAFANA_ADMIN_PASSWORD=change-me-locally         # local demo only
