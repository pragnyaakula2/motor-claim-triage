   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by(reason)(rate(escalations_total[1m]))",
     "legendFormat": "{{reason}}",
     "refId": "A"
    }
   ]
  },
  {
