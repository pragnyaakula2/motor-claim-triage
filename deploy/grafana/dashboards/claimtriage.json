   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max(llm_circuit_breaker_state)",
     "legendFormat": "breaker",
     "refId": "A"
    },
    {
     "expr": "sum by(path)(rate(degraded_runs_total[1m]))",
     "legendFormat": "degraded {{path}}",
     "refId": "B"
    }
   ]
  },
  {
   "id": 16,
   "title": "LLM cost USD / s (notional) by step",
